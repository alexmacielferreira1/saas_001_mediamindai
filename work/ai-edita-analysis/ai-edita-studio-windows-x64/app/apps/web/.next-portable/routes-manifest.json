  "dynamicRoutes": [
    {
      "page": "/api/auth/[...all]",
      "regex": "^/api/auth/(.+?)(?:/)?$",
      "routeKeys": {
        "nxtPall": "nxtPall"
      },
      "namedRegex": "^/api/auth/(?<nxtPall>.+?)(?:/)?$"
    },
    {
      "page": "/api/remotion/jobs/[job_id]",
      "regex": "^/api/remotion/jobs/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPjob_id": "nxtPjob_id"
      },
      "namedRegex": "^/api/remotion/jobs/(?<nxtPjob_id>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/remotion/jobs/[job_id]/file",
