{
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python -m pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run build:*)",
      "Bash(npm run typecheck:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Read(./backend/.env)",
      "Read(./frontend/.env)",
      "Read(./frontend/.env.local)",
      "Read(./frontend/.env.production)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/pos_edicao.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/pos_edicao.py\" 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "trailofbits": {
      "source": { "source": "github", "repo": "trailofbits/skills" }
    }
  },
  "enabledPlugins": {
    "insecure-defaults@trailofbits": true,
    "sharp-edges@trailofbits": true,
    "differential-review@trailofbits": true,
    "supply-chain-risk-auditor@trailofbits": true
  }
}
