APP_NAME=mediamind
ENVIRONMENT=local
# Render/produção: definir ENVIRONMENT=production e SESSION_COOKIE_SECURE=true;
# FRONTEND_URL e GOOGLE_REDIRECT_URI devem usar HTTPS. Nunca colocar segredos aqui.
DATABASE_URL=postgresql+psycopg://mediamind:local_dev_only@127.0.0.1:5433/mediamind
POSTGRES_USER=mediamind
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=mediamind
POSTGRES_PORT=5433
API_PORT=8000
FRONTEND_PORT=5173
SESSION_HOURS=8
SESSION_COOKIE_SECURE=false
# Obrigatória apenas ao executar scripts/seed-demo.ps1; nunca versionar a senha real.
DEMO_PASSWORD=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
FRONTEND_URL=http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# Chave Fernet para criptografar credenciais da IA de thumbs. Definir no servidor.
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
THUMBNAIL_SECRET_KEY=
# Em produção, usar diretório persistente para as imagens enviadas e recortes.
# MEDIA_ROOT=/caminho/do/disco/media
