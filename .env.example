APP_NAME=mediamind
ENVIRONMENT=local
# Render/produção: definir ENVIRONMENT=production e SESSION_COOKIE_SECURE=true;
# FRONTEND_URL e GOOGLE_REDIRECT_URI devem usar HTTPS. Nunca colocar segredos aqui.
DATABASE_URL=postgresql+psycopg://mediamind:local_dev_only@127.0.0.1:5433/mediamind
POSTGRES_USER=mediamind
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=mediamind
POSTGRES_PORT=5433
API_PORT=8000
FRONTEND_PORT=5173
SESSION_HOURS=8
SESSION_COOKIE_SECURE=false
# Obrigatória apenas ao executar scripts/seed-demo.ps1; nunca versionar a senha real.
DEMO_PASSWORD=
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
FRONTEND_URL=http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/api/v1/auth/google/callback

# Chave Fernet para criptografar credenciais da IA de thumbs. Definir no servidor.
# Gerar com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
THUMBNAIL_SECRET_KEY=
# Chave Fernet usada para criptografar, por cliente, as chaves dos provedores de IA.
# Gerar com o mesmo comando acima. Nunca versionar a chave real.
AI_SECRET_KEY=
# Em produção, usar diretório persistente para as imagens enviadas e recortes.
# MEDIA_ROOT=/caminho/do/disco/media

# Segurança (20/10/2026)
# Origens extras aceitas em POST/PATCH/DELETE com cookie (separadas por vírgula). O FRONTEND_URL já entra.
CSRF_TRUSTED_ORIGINS=
# Admin API do HUB: escopos concedidos ao token da Central (definidos aqui, nunca pelo chamador).
# Valores: "hub:observe" (só leitura) e/ou "hub:command" (comandos). Vazio = padrão (os dois).
HUB_ADMIN_SCOPES=hub:observe hub:command
# Expiração opcional do token da Admin API (ISO 8601, ex.: 2027-01-31T23:59:59Z). Vazio = sem expiração.
HUB_ADMIN_TOKEN_EXPIRES_AT=
# Só para desenvolvimento local: permite chamadas do servidor a endereços internos (ex.: IA em 127.0.0.1).
# Recusado em produção.
OUTBOUND_ALLOW_PRIVATE_NETWORKS=false
