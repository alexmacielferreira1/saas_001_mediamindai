{
  "name": "Clip",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "default": "",
      "description": "Tenant: id da empresa (Empresa) a que o registro pertence"
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "description": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "ready",
        "sent_to_publish",
        "published"
      ],
      "default": "draft"
    },
    "source_asset_id": {
      "type": "string",
      "default": "",
      "description": "ID do Asset master de origem (edi\u00e7\u00e3o n\u00e3o destrutiva)"
    },
    "source_url": {
      "type": "string",
      "default": "",
      "description": "URL de reprodu\u00e7\u00e3o do master (usada apenas pelo player)"
    },
    "parent_clip_id": {
      "type": "string",
      "default": "",
      "description": "Clip pai quando este \u00e9 uma varia\u00e7\u00e3o/vers\u00e3o derivada"
    },
    "project_id": {
      "type": "string",
      "default": ""
    },
    "in_ms": {
      "type": "number",
      "default": 0,
      "description": "Ponto de entrada do corte no master (ms)"
    },
    "out_ms": {
      "type": "number",
      "default": 0,
      "description": "Ponto de sa\u00edda do corte no master (ms)"
    },
    "duration": {
      "type": "number",
      "default": 0,
      "description": "Dura\u00e7\u00e3o do corte (out - in) em ms"
    },
    "suggested_in_ms": {
      "type": "number",
      "default": 0,
      "description": "IN sugerido pela IA (melhoria de contexto)"
    },
    "suggested_out_ms": {
      "type": "number",
      "default": 0,
      "description": "OUT sugerido pela IA"
    },
    "prompt": {
      "type": "string",
      "default": "",
      "description": "Instru\u00e7\u00e3o editorial usada na an\u00e1lise"
    },
    "purpose": {
      "type": "string",
      "default": "social",
      "description": "Finalidade: social, jornalismo, podcast, etc."
    },
    "language": {
      "type": "string",
      "default": "pt-BR"
    },
    "aspect_ratio": {
      "type": "string",
      "enum": [
        "9:16",
        "16:9",
        "1:1",
        "4:5"
      ],
      "default": "9:16"
    },
    "stage": {
      "type": "string",
      "enum": [
        "selecao",
        "ia",
        "legendas",
        "cg",
        "reimport"
      ],
      "default": "selecao",
      "description": "Etapa atual no workspace de cortes"
    },
    "overall_score": {
      "type": "number",
      "default": 0
    },
    "hook_score": {
      "type": "number",
      "default": 0
    },
    "hook_grade": {
      "type": "string",
      "default": ""
    },
    "hook_explanation": {
      "type": "string",
      "default": ""
    },
    "flow_score": {
      "type": "number",
      "default": 0
    },
    "flow_grade": {
      "type": "string",
      "default": ""
    },
    "flow_explanation": {
      "type": "string",
      "default": ""
    },
    "value_score": {
      "type": "number",
      "default": 0
    },
    "value_grade": {
      "type": "string",
      "default": ""
    },
    "value_explanation": {
      "type": "string",
      "default": ""
    },
    "trend_score": {
      "type": "number",
      "default": 0
    },
    "trend_grade": {
      "type": "string",
      "default": ""
    },
    "trend_explanation": {
      "type": "string",
      "default": ""
    },
    "relevance_score": {
      "type": "number",
      "default": 0
    },
    "autonomy_score": {
      "type": "number",
      "default": 0
    },
    "editorial_score": {
      "type": "number",
      "default": 0
    },
    "ai_reason": {
      "type": "string",
      "default": "",
      "description": "Por que a IA escolheu este trecho (resumo editorial)"
    },
    "keywords": {
      "type": "string",
      "default": ""
    },
    "favorite": {
      "type": "boolean",
      "default": false
    },
    "selected": {
      "type": "boolean",
      "default": false
    },
    "current_version_id": {
      "type": "string",
      "default": ""
    },
    "editor": {
      "type": "string",
      "default": ""
    },
    "program_name": {
      "type": "string",
      "default": ""
    },
    "channels": {
      "type": "string",
      "default": ""
    },
    "file_size": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}