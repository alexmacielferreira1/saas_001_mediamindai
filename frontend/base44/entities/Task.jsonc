{
  "name": "Task",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "default": "",
      "description": "Tenant: id da empresa (Empresa) a que o registro pertence"
    },
    "title": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "delivered",
        "approved"
      ],
      "default": "not_started"
    },
    "assigned_to_id": {
      "type": "number",
      "default": null
    },
    "project_name": {
      "type": "string",
      "default": ""
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "due_date": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "title",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}