{
  "name": "AprovacaoVersao",
  "type": "object",
  "properties": {
    "asset_id": {
      "type": "number",
      "description": "ID do asset aprovado/reprovado"
    },
    "asset_title": {
      "type": "string",
      "description": "T\u00edtulo denormalizado do asset"
    },
    "versao": {
      "type": "string",
      "default": "v1",
      "description": "Vers\u00e3o espec\u00edfica sob revis\u00e3o"
    },
    "decisao": {
      "type": "string",
      "enum": [
        "aprovado",
        "reprovado",
        "pendente"
      ],
      "default": "pendente"
    },
    "comentario": {
      "type": "string",
      "default": "",
      "description": "Justificativa da decis\u00e3o"
    }
  },
  "required": [
    "asset_id",
    "decisao"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}