{
  "name": "TranscricaoSegmento",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "default": "",
      "description": "Tenant: id da empresa (Empresa) a que o registro pertence"
    },
    "asset_id": {
      "type": "string",
      "description": "ID do asset transcrito"
    },
    "start_ms": {
      "type": "number",
      "default": 0,
      "description": "In\u00edcio do trecho em milissegundos"
    },
    "end_ms": {
      "type": "number",
      "default": 0,
      "description": "Fim do trecho em milissegundos"
    },
    "texto": {
      "type": "string",
      "description": "Texto do segmento transcrito"
    },
    "source": {
      "type": "string",
      "default": "whisper",
      "description": "Origem da transcri\u00e7\u00e3o"
    },
    "model": {
      "type": "string",
      "default": "whisper-large",
      "description": "Modelo usado"
    },
    "confidence": {
      "type": "number",
      "default": 0
    },
    "verified": {
      "type": "boolean",
      "default": false,
      "description": "Sugest\u00e3o de IA vira metadado oficial s\u00f3 ap\u00f3s revis\u00e3o humana"
    },
    "reviewer": {
      "type": "string",
      "default": "",
      "description": "Quem revisou"
    },
    "timing_quality": {
      "type": "string",
      "enum": [
        "exact",
        "estimated"
      ],
      "default": "estimated",
      "description": "exact = timestamps reais por palavra/segmento; estimated = distribui\u00e7\u00e3o proporcional"
    },
    "speaker_id": {
      "type": "string",
      "default": ""
    },
    "speaker_label": {
      "type": "string",
      "default": ""
    },
    "language": {
      "type": "string",
      "default": ""
    },
    "is_pause": {
      "type": "boolean",
      "default": false,
      "description": "Trecho de sil\u00eancio/pausa detectado (limpeza de fala)"
    }
  },
  "required": [
    "asset_id",
    "texto"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}