{
  "name": "LogAuditoria",
  "type": "object",
  "properties": {
    "acao": {
      "type": "string",
      "description": "A\u00e7\u00e3o registrada (Upload, Transcri\u00e7\u00e3o, Aprova\u00e7\u00e3o, Coment\u00e1rio, etc.)"
    },
    "entidade": {
      "type": "string",
      "default": "",
      "description": "Tipo de entidade afetada"
    },
    "detalhe": {
      "type": "string",
      "default": "",
      "description": "Descri\u00e7\u00e3o leg\u00edvel do evento"
    },
    "ator": {
      "type": "string",
      "default": "",
      "description": "Quem executou (vazio = usu\u00e1rio logado, via created_by)"
    }
  },
  "required": [
    "acao"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}