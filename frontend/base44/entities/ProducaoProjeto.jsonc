{
  "name": "ProducaoProjeto",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "default": "",
      "description": "Tenant: id da empresa (Empresa) a que o registro pertence"
    },
    "programa": {
      "type": "string",
      "default": "",
      "description": "Programa ao qual a produ\u00e7\u00e3o pertence"
    },
    "episodio": {
      "type": "string",
      "default": "",
      "description": "Identificador do epis\u00f3dio (ex.: EP054)"
    },
    "titulo": {
      "type": "string",
      "default": "Nova produ\u00e7\u00e3o"
    },
    "etapa": {
      "type": "string",
      "enum": [
        "rascunho",
        "gravacao",
        "em_edicao",
        "em_aprovacao",
        "finalizado"
      ],
      "default": "rascunho",
      "description": "Est\u00e1gio atual no pipeline de Produ\u00e7\u00e3o"
    },
    "responsavel": {
      "type": "string",
      "default": ""
    },
    "headline": {
      "type": "string",
      "default": ""
    },
    "descricao": {
      "type": "string",
      "default": ""
    },
    "pauta": {
      "type": "string",
      "default": ""
    },
    "convidado_nome": {
      "type": "string",
      "default": ""
    },
    "convidado_cg": {
      "type": "string",
      "default": ""
    },
    "gravacao_data": {
      "type": "string",
      "format": "date",
      "default": ""
    },
    "gravacao_horario": {
      "type": "string",
      "default": ""
    },
    "gravacao_estudio": {
      "type": "string",
      "default": ""
    },
    "equipe": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Funcion\u00e1rios alocados \u00e0 grava\u00e7\u00e3o"
    },
    "apresentadores": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Lista de { nome, cg } dos apresentadores"
    },
    "gravada": {
      "type": "boolean",
      "default": false
    },
    "grav_status": {
      "type": "string",
      "default": "",
      "description": "agendada | gravada | vazio"
    },
    "videomaker": {
      "type": "string",
      "default": ""
    },
    "videomaker_confirmado": {
      "type": "boolean",
      "default": false
    },
    "editor": {
      "type": "string",
      "default": ""
    },
    "pasta_midias": {
      "type": "string",
      "default": ""
    },
    "historico": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "default": [],
      "description": "Transi\u00e7\u00f5es de etapa { etapa, quem, quando, obs }"
    },
    "ordem": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "titulo",
    "etapa"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}