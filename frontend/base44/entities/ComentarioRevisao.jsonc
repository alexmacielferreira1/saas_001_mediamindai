{
  "name": "ComentarioRevisao",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "default": "",
      "description": "Tenant: id da empresa (Empresa) a que o registro pertence"
    },
    "asset_id": {
      "type": "number",
      "description": "ID do asset (mock ou real) que o coment\u00e1rio referencia"
    },
    "asset_title": {
      "type": "string",
      "description": "T\u00edtulo denormalizado do asset para exibi\u00e7\u00e3o"
    },
    "timecode_ms": {
      "type": "number",
      "default": 0,
      "description": "Posi\u00e7\u00e3o em milissegundos (0 = coment\u00e1rio geral)"
    },
    "timecode_label": {
      "type": "string",
      "default": "00:00:00",
      "description": "R\u00f3tulo leg\u00edvel do timecode"
    },
    "texto": {
      "type": "string",
      "description": "Conte\u00fado do coment\u00e1rio / anota\u00e7\u00e3o"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberta",
        "resolvida",
        "reaberta"
      ],
      "default": "aberta"
    },
    "versao": {
      "type": "string",
      "default": "v1",
      "description": "Vers\u00e3o do asset \u00e0 qual o coment\u00e1rio est\u00e1 preso"
    }
  },
  "required": [
    "asset_id",
    "texto"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}