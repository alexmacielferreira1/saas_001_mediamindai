{
  "name": "ClipVersion",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "default": "",
      "description": "Tenant: id da empresa (Empresa) a que o registro pertence"
    },
    "clip_id": {
      "type": "string",
      "description": "ID do Clip pai (edi\u00e7\u00e3o n\u00e3o destrutiva \u2014 vers\u00f5es derivadas)"
    },
    "version_label": {
      "type": "string",
      "default": "v1",
      "description": "R\u00f3tulo da vers\u00e3o (v1, v2-editado, master, etc.)"
    },
    "edited_url": {
      "type": "string",
      "default": "",
      "description": "URL do arquivo editado reimportado"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent_to_publish",
        "published",
        "archived"
      ],
      "default": "draft"
    },
    "is_current": {
      "type": "boolean",
      "default": false,
      "description": "Indica a vers\u00e3o ativa do clip (apenas uma por clip)"
    },
    "notes": {
      "type": "string",
      "default": "",
      "description": "Notas do editor sobre esta vers\u00e3o"
    },
    "file_size": {
      "type": "number",
      "default": 0
    },
    "created_by_name": {
      "type": "string",
      "default": "",
      "description": "Nome/autor da vers\u00e3o (denormalizado)"
    }
  },
  "required": [
    "clip_id",
    "version_label"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}