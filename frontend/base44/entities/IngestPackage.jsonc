{
  "name": "IngestPackage",
  "type": "object",
  "properties": {
    "empresa_id": {
      "type": "string",
      "default": "",
      "description": "Tenant: id da empresa (Empresa) a que o registro pertence"
    },
    "name": {
      "type": "string",
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "processing",
        "completed",
        "failed"
      ],
      "default": "queued"
    },
    "file_count": {
      "type": "number",
      "default": 0
    },
    "created_at": {
      "type": "string",
      "default": ""
    },
    "owner": {
      "type": "string",
      "default": ""
    },
    "progress": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "name",
    "status"
  ],
  "rls": {
    "read": {},
    "create": {},
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}